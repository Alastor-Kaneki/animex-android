<resources>
    <style name="Theme.Animex" parent="android:style/Theme.Material">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:actionBarStyle">@style/Theme.Animex.ActionBar</item>
    </style>

    <style name="Theme.Animex.Splash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Animex.ActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">#000000</item>
        <item name="android:titleTextStyle">@style/Theme.Animex.ActionBar.Title</item>
    </style>

    <style name="Theme.Animex.ActionBar.Title" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
